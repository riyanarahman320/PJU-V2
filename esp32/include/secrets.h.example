/* Template konfigurasi rahasia firmware ASEP-JAGA.
 *
 * CARA PAKAI:
 *   1. Salin file ini menjadi esp32/include/secrets.h
 *   2. Ganti setiap nilai CHANGE_ME
 *
 * secrets.h TIDAK di-commit ke Git (lihat .gitignore).
 * File .example ini aman di-commit karena tidak memuat nilai sungguhan.
 *
 * PENTING - HANYA DEVICE_API_KEY YANG BOLEH ADA DI FIRMWARE.
 * Jangan pernah menaruh DEVICE_CONFIG_API_KEY (kunci operator), SECRET_KEY
 * Flask, atau TOMTOM_API_KEY di sini. Firmware dapat dibaca ulang dari flash
 * perangkat yang dipasang di ruang publik, jadi apa pun yang ada di sini
 * harus dianggap dapat diketahui orang lain.
 */

#ifndef ASEPJAGA_SECRETS_H
#define ASEPJAGA_SECRETS_H

/* --- WiFi ---------------------------------------------------------- */
#define WIFI_SSID "CHANGE_ME_nama_wifi"
#define WIFI_PASSWORD "CHANGE_ME_password_wifi"

/* --- Server --------------------------------------------------------
 * Ada DUA URL, dipilih otomatis oleh WOKWI_BUILD di config.h:
 *
 *   WOKWI_BUILD 1 -> SERVER_BASE_URL_WOKWI  (HTTP, prototype)
 *   WOKWI_BUILD 0 -> SERVER_BASE_URL_REAL   (HTTPS, hardware nyata)
 *
 * Keduanya tanpa garis miring di akhir.
 *
 * MENGAPA ADA DUA
 * ---------------
 * ESP32-S3 di simulator Wokwi gagal melakukan TLS handshake ke tunnel HTTPS
 * publik (start_ssl_client: -80, SSL EOF). Supaya arsitektur tetap dapat
 * diuji end-to-end, prototype memakai HTTP biasa.
 *
 * PERINGATAN: HTTP biasa mengirim DEVICE_API_KEY tanpa enkripsi. Pakai kunci
 * uji, bukan kunci produksi, saat WOKWI_BUILD = 1.
 *
 * PILIHAN UNTUK SERVER_BASE_URL_WOKWI
 * -----------------------------------
 * a. "http://host.wokwi.internal:5000"
 *    Menunjuk ke localhost komputer Anda. HANYA berfungsi bila Wokwi
 *    Private IoT Gateway berjalan, dan gateway itu fitur BERBAYAR.
 *
 * b. "http://<host-tunnel-http>"
 *    Tunnel HTTP biasa (mis. localtunnel/serveo, atau ngrok dengan
 *    --scheme http). Berfungsi tanpa langganan Wokwi.
 *
 * c. "http://192.168.1.10:5000"
 *    IP LAN komputer Anda. TIDAK dapat dijangkau dari Wokwi Public Gateway
 *    (gateway ada di cloud, bukan di jaringan Anda). Ini hanya untuk board
 *    sungguhan di WiFi yang sama.
 *
 * Bila memakai https, firmware memanggil setInsecure() sehingga sertifikat
 * TIDAK diverifikasi. Lihat catatan TLS di src/main.cpp.
 */
#define SERVER_BASE_URL_WOKWI "http://host.wokwi.internal:5000"
#define SERVER_BASE_URL_REAL "https://CHANGE_ME.example.com"

/* Pemilihan otomatis. Jangan diubah; ubah WOKWI_BUILD di config.h. */
#if WOKWI_BUILD
#define SERVER_BASE_URL SERVER_BASE_URL_WOKWI
#else
#define SERVER_BASE_URL SERVER_BASE_URL_REAL
#endif

/* --- Identitas perangkat -------------------------------------------
 * DEVICE_ID harus sama dengan yang terdaftar di database server.
 */
#define DEVICE_ID "ASEP-012"
#define DEVICE_NAME "PJU Babakan Sari 12"
#define DEVICE_LOCATION "Jl. Babakan Sari, Kiaracondong"

/* Koordinat titik PJU. Dikirim saat register dan saat emergency.
 * Server memvalidasi rentang: latitude -90..90, longitude -180..180.
 */
#define DEVICE_LATITUDE -6.9200
#define DEVICE_LONGITUDE 107.6400

/* --- Kunci perangkat -----------------------------------------------
 * Sama dengan DEVICE_API_KEY di .env server.
 * Dikirim lewat header: X-API-Key
 */
#define DEVICE_API_KEY "CHANGE_ME_device_api_key"

#endif /* ASEPJAGA_SECRETS_H */